+/* src/include/port/android.h
+ *
+ * Android port header for pgandroid — single-process embedded PostgreSQL.
+ * Mirrors the structure of emscripten.h and wasi.h.
+ *
+ * Included automatically when building with __ANDROID_PGANDROID__ defined
+ * (set in the Android NDK CMake toolchain or configure script).
+ */
+
+#ifndef I_ANDROID_PGANDROID
+#define I_ANDROID_PGANDROID
+
+/*
+ * Include the Android-specific common header (analog of wasm_common.h).
+ * This must be found in the build include path, e.g. via:
+ *   -I$(PGANDROID_SRCDIR)/src/include/port
+ */
+#include "android_pgandroid.h"
+
+/*
+ * Mark that we have detected a boot-completion boundary.
+ * The bootstrap sequence logs "build indices" when catalog init finishes.
+ */
+#define BOOT_END_MARK "build indices"
+
+/* Maximum size of the file descriptor read buffer used in fd.c */
+#define FD_BUFFER_MAX 16384
+
+#endif /* I_ANDROID_PGANDROID */
diff --git a/src/include/port/android_pgandroid.h b/src/include/port/android_pgandroid.h
new file mode 100644
--- /dev/null
+++ b/src/include/port/android_pgandroid.h
@@ -0,0 +1,271 @@
+/* src/include/port/android_pgandroid.h
+ *
+ * Android-specific compatibility header for pgandroid.
+ * This is the Android equivalent of wasm_common.h from PGlite.
+ *
+ * Included by android.h which is included when __ANDROID_PGANDROID__ is
+ * defined in the build. Do NOT include directly; include android.h instead.
+ *
+ * Key responsibilities:
+ *  - proc_exit -> pg_proc_exit rename (cannot call exit() in a JNI library)
+ *  - WAIT_USE_POLL (poll-based I/O waiting, no epoll between processes)
+ *  - Startup option array (ANDROID_PGOPTS)
+ *  - Malloc-based SysV shared memory stubs (when PG_SHMEM is defined)
+ *  - locale -a interception stub (when PG_FD is defined)
+ *  - Android logcat routing for PostgreSQL log output
+ *  - JNI I/O buffer declarations (filled in by pgandroid_io.c)
+ */
+
+#pragma once
+
+#include <stdio.h>   /* FILE */
+#include <stdlib.h>  /* malloc, free, abort */
+#include <string.h>  /* strlen, strcat */
+#include <unistd.h>  /* access, F_OK */
+
+/* -----------------------------------------------------------------------
+ * Build mode: poll-based waiting (no eventfd / epoll across processes)
+ * ----------------------------------------------------------------------- */
+#define WAIT_USE_POLL 1
+
+/* Linux kernel bug workaround — keep consistent with wasm_common.h */
+#define HAVE_LINUX_EIDRM_BUG
+
+/*
+ * Default WAL sync method: fdatasync avoids O_DIRECT issues on ext4
+ * data=journal filesystems (same rationale as wasm_common.h).
+ */
+#define PLATFORM_DEFAULT_WAL_SYNC_METHOD  WAL_SYNC_METHOD_FDATASYNC
+
+/* -----------------------------------------------------------------------
+ * Default username for --single mode (pgandroid runs as standalone backend)
+ * ----------------------------------------------------------------------- */
+#if !defined(ANDROID_USERNAME)
+#define ANDROID_USERNAME "postgres"
+#endif
+
+/* -----------------------------------------------------------------------
+ * Default PostgreSQL startup options for embedded Android use.
+ * Passed as argv[] to PostgresSingleUserMain() / BootstrapModeMain().
+ *
+ * Notable choices:
+ *   log_checkpoints=false   — reduce logcat noise
+ *   exit_on_error=true      — hard errors abort the query, not the process
+ *   ignore_invalid_pages=on — tolerate minor WAL corruption on first boot
+ *   fsync=on                — default on; app can override via pgandroid_set_option()
+ * ----------------------------------------------------------------------- */
+#define ANDROID_PGOPTS \
+    "-c", "log_checkpoints=false", \
+    "-c", "search_path=pg_catalog", \
+    "-c", "exit_on_error=true", \
+    "-c", "ignore_invalid_pages=on", \
+    "-c", "temp_buffers=8MB", \
+    "-c", "work_mem=4MB", \
+    "-c", "fsync=on", \
+    "-c", "synchronous_commit=on", \
+    "-c", "wal_buffers=4MB", \
+    "-c", "min_wal_size=80MB", \
+    "-c", "shared_buffers=128MB"
+
+/* -----------------------------------------------------------------------
+ * proc_exit -> pg_proc_exit rename.
+ *
+ * In a JNI library, calling exit() terminates the entire Android app.
+ * pg_proc_exit() (defined in pgandroid_main.c) runs on_proc_exit callbacks
+ * and then RETURNS to its caller (the JNI entry point) instead of calling
+ * exit(). The JNI layer translates the exit code into a Java exception.
+ *
+ * Sentinel exit code 66 = "graceful pgandroid shutdown, run cleanup, return".
+ * ----------------------------------------------------------------------- */
+#define proc_exit(arg)  pg_proc_exit(arg)
+
+/* -----------------------------------------------------------------------
+ * Combined link unit: encoding helpers.
+ * When frontend and backend are compiled into the same shared library,
+ * the encoding lookup functions conflict. Rename them to private versions.
+ * ----------------------------------------------------------------------- */
+
+/* Exported from src/common/encnames.c or backend/utils/mb/mbutils.c */
+extern int         pg_char_to_encoding_private(const char *name);
+extern const char *pg_encoding_to_char_private(int encoding);
+extern int         pg_valid_server_encoding_id_private(int encoding);
+
+#if defined(pg_char_to_encoding)
+#undef pg_char_to_encoding
+#endif
+#define pg_char_to_encoding(enc)            pg_char_to_encoding_private(enc)
+
+#if defined(pg_encoding_to_char)
+#undef pg_encoding_to_char
+#endif
+#define pg_encoding_to_char(enc)            pg_encoding_to_char_private(enc)
+
+#if defined(pg_valid_server_encoding_id)
+#undef pg_valid_server_encoding_id
+#endif
+#define pg_valid_server_encoding_id(enc)    pg_valid_server_encoding_id_private(enc)
+
+/* fe_utils/string_utils.c exports this; avoid duplicate symbol */
+#include <stdbool.h>
+extern bool fe_utils_quote_all_identifiers;
+
+/* -----------------------------------------------------------------------
+ * JNI I/O buffer interface.
+ *
+ * In pgandroid, pqcomm.c does not use real sockets. Instead:
+ *  - pgandroid_io_put_input()  is called by the JNI entry point to inject a
+ *    PostgreSQL wire-protocol query message into the receive buffer.
+ *  - pgandroid_io_get_output() is called after query execution to retrieve
+ *    the response (as a JSON string or raw wire-protocol bytes).
+ *
+ * These are declared here so that pqcomm.c (patch 002) can reference them.
+ * Definitions are in pgandroid_io.c (part of the pgandroid entry-point layer).
+ * ----------------------------------------------------------------------- */
+extern void  pgandroid_io_put_input(const char *data, int len);
+extern char *pgandroid_io_get_output(int *out_len);
+extern void  pgandroid_io_reset(void);
+
+/* -----------------------------------------------------------------------
+ * Android logcat integration.
+ * Route PostgreSQL elog/ereport output to the Android system log.
+ * The actual __android_log_print call is in pgandroid_main.c to avoid
+ * pulling <android/log.h> into every PostgreSQL translation unit.
+ * ----------------------------------------------------------------------- */
+extern void pgandroid_log(int elevel, const char *message);
+
+/* -----------------------------------------------------------------------
+ * OpenPipeStream interception (when building fd.c: PG_FD defined).
+ *
+ * initdb calls popen("locale -a") to discover available locales.
+ * On Android there is no locale binary. We intercept OpenPipeStream
+ * and return a fake locale file containing "C", "C.UTF-8", and "POSIX".
+ *
+ * This section is compiled only when fd.c defines PG_FD before including
+ * this header, so it does not pollute other translation units.
+ * ----------------------------------------------------------------------- */
+#if defined(PG_FD)
+
+FILE *android_OpenPipeStream(const char *command, const char *mode);
+
+FILE *
+android_OpenPipeStream(const char *command, const char *mode)
+{
+    FILE       *result = NULL;
+    const char *datadir = getenv("PGDATA");
+    const char *suffix  = "/android_locale";
+    char       *localefile;
+
+    if (!datadir)
+        datadir = "/data/data/com.example.pgandroid/files/pgdata";
+
+    localefile = malloc(strlen(datadir) + strlen(suffix) + 1);
+    if (!localefile)
+        return NULL;
+
+    strcpy(localefile, datadir);
+    strcat(localefile, suffix);
+
+    if (access(localefile, F_OK) != 0)
+    {
+        /* Create the fake locale list on first call */
+        FILE *fakeloc = fopen(localefile, "w");
+        if (fakeloc)
+        {
+            const char *encoding = getenv("PGCLIENTENCODING");
+            if (!encoding)
+                encoding = "UTF-8";
+            fprintf(fakeloc, "C\nC.%s\nPOSIX\n%s\n", encoding, encoding);
+            fclose(fakeloc);
+        }
+    }
+
+    result = fopen(localefile, "r");
+    free(localefile);
+    return result;
+}
+
+#else  /* !PG_FD — used from other translation units */
+
+extern FILE *android_OpenPipeStream(const char *command, const char *mode);
+
+/* Override OpenPipeStream in all non-fd.c TUs */
+#define OpenPipeStream(cmd, mode)  android_OpenPipeStream((cmd), (mode))
+
+#endif /* PG_FD */
+
+
+/* -----------------------------------------------------------------------
+ * Malloc-based SysV shared memory stubs (when building sysv_shmem.c).
+ *
+ * Compiled only when sysv_shmem.c defines PG_SHMEM before inclusion.
+ * In single-process embedded mode, shared memory can be a plain heap
+ * allocation — there are no other processes to attach to the segment.
+ * ----------------------------------------------------------------------- */
+#if defined(PG_SHMEM)
+
+#include <sys/shm.h>
+#include <sys/stat.h>
+
+static volatile void  *FAKE_SHM = NULL;
+static volatile key_t  FAKE_KEY = 0;
+
+/*
+ * shmget: allocate the fake shared memory block on first call.
+ * Returns fake key 666 on success, -1 on failure.
+ */
+int
+shmget(key_t key, size_t size, int shmflg)
+{
+    if (!FAKE_KEY)
+    {
+        FAKE_SHM = malloc(size);
+        if (!FAKE_SHM)
+            return -1;
+        FAKE_KEY = 666;
+        return (int) FAKE_KEY;
+    }
+    /* Already allocated; return existing key */
+    return (int) FAKE_KEY;
+}
+
+/*
+ * shmat: return pointer to the fake shared memory block.
+ */
+void *
+shmat(int shmid, const void *shmaddr, int shmflg)
+{
+    if (shmid == 666)
+        return (void *) FAKE_SHM;
+    abort(); /* Should never happen in single-process mode */
+    return NULL;
+}
+
+/* shmdt: no-op — memory is managed by malloc/free lifecycle */
+int
+shmdt(const void *shmaddr)
+{
+    return 0;
+}
+
+/* shmctl: no-op for IPC_RMID and IPC_STAT in single-process mode */
+int
+shmctl(int shmid, int cmd, struct shmid_ds *buf)
+{
+    return 0;
+}
+
+#endif /* PG_SHMEM */
+
+
+/* -----------------------------------------------------------------------
+ * Attribute macros.
+ * PGANDROID_EXPORT marks JNI-exported functions (visible outside the .so).
+ * ----------------------------------------------------------------------- */
+#ifndef PGANDROID_EXPORT
+#  define PGANDROID_EXPORT __attribute__((visibility("default")))
+#endif
+
+/* Suppress "attribute noreturn" on pg_proc_exit — it returns in pgandroid */
+#ifndef pg_attribute_noreturn
+#  define pg_attribute_noreturn()  /* nothing */
+#endif
diff --git a/src/template/android b/src/template/android
new file mode 100644
--- /dev/null
+++ b/src/template/android
@@ -0,0 +1,54 @@
+# src/template/android
+#
+# Template for building PostgreSQL (pgandroid) with the Android NDK.
+# Used by configure when --host=aarch64-linux-android (or arm-linux-androideabi).
+#
+# Usage:
+#   ./configure \
+#     --host=aarch64-linux-android \
+#     --without-readline \
+#     --without-zlib \
+#     CC=$NDK/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android35-clang \
+#     CFLAGS="-D__ANDROID_PGANDROID__" \
+#     template=android
+#
+# Alternatively, use the CMakeLists.txt in the pgandroid repo which calls
+# configure internally with the correct flags.
+
+# Semaphore implementation: unnamed POSIX semaphores (sem_init/sem_wait/sem_post)
+# are supported by Android bionic. SysV semaphores (semget) are also available
+# but not used in pgandroid (we stub shared memory with malloc instead).
+PREFERRED_SEMAPHORES=UNNAMED_POSIX
+
+# GNU extensions: needed for various PostgreSQL internal APIs
+# (e.g., asprintf, strndup, pthread_setname_np)
+template_defines="_GNU_SOURCE"
+
+# Position-independent code: required for shared library (.so) output
+CFLAGS_SL="-fPIC"
+LDFLAGS_SL=""
+
+# Dynamic linking: Android uses its own linker; -ldl is provided by bionic
+DLSUFFIX=".so"
+
+# Thread safety: Android bionic is thread-safe; use pthreads
+template_defines="$template_defines HAVE_PTHREAD_PRIO_INHERIT"
+
+# Android API level: minimum 26 (Android 8.0 Oreo) for full POSIX support
+# Set by the NDK toolchain; ensure ANDROID_NATIVE_API_LEVEL >= 26
+
+# Disable features not available or not needed in Android embedded mode
+template_defines="$template_defines __ANDROID_PGANDROID__"
+
+# WAL sync: fdatasync is the safe choice on Android's ext4-based filesystems
+# (same reasoning as Linux and WASM builds)
+CFLAGS="$CFLAGS -DPLATFORM_DEFAULT_WAL_SYNC_METHOD=WAL_SYNC_METHOD_FDATASYNC"
+
+# Shared memory: pgandroid stubs SysV IPC with malloc; inform autoconf
+# (no shmget/shmctl kernel calls are made at runtime)
+pgac_cv_prog_cc_int128=yes
+
+# JNI: headers are provided by the Android NDK
+# Add $NDK/sysroot/usr/include to the include path in your CMakeLists.txt
+
+# Locale: Android has no locale binary; pgandroid intercepts popen("locale -a")
+# via android_OpenPipeStream() in android_pgandroid.h
+
+# End of src/template/android
diff --git a/src/backend/port/posix_sema.c b/src/backend/port/posix_sema.c
--- a/src/backend/port/posix_sema.c
+++ b/src/backend/port/posix_sema.c
@@ -1,6 +1,9 @@
 /*
  * src/backend/port/posix_sema.c
  *
+ * PATCH 001 (pgandroid): __ANDROID_PGANDROID__ added alongside WASM guards
+ * in PGSemaphoreReset() drain loop — same single-process rationale.
+ *
  * In single-process mode there are no other processes that could have
  * posted to a semaphore, so the draining loop is unnecessary and can
  * deadlock. Short-circuit it for WASM and Android.
@@ -20,7 +22,7 @@
 void
 PGSemaphoreReset(PGSemaphore sema)
 {
-#if defined(__EMSCRIPTEN__) || defined(__wasi__)
+#if defined(__EMSCRIPTEN__) || defined(__wasi__) || defined(__ANDROID_PGANDROID__)
     /* Single-process: at most one token in semaphore; one trywait suffices */
     sem_trywait(PG_SEM_REF(sema));
 #else
diff --git a/src/backend/storage/ipc/ipc.c b/src/backend/storage/ipc/ipc.c
--- a/src/backend/storage/ipc/ipc.c
+++ b/src/backend/storage/ipc/ipc.c
@@ -1,5 +1,8 @@
 /*
  * src/backend/storage/ipc/ipc.c
+ *
+ * PATCH 001 (pgandroid): pg_proc_exit() returns instead of calling exit()
+ * when __ANDROID_PGANDROID__ is defined, using exit code 66 as the sentinel.
  */

 /*
@@ -60,7 +63,7 @@ pg_proc_exit(int code)
      * Return gracefully on code 66 (pgandroid/PGlite graceful shutdown):
      * run on_proc_exit callbacks but do NOT call exit() — return to JNI.
      */
-#if defined(__EMSCRIPTEN__) || defined(__wasi__)
+#if defined(__EMSCRIPTEN__) || defined(__wasi__) || defined(__ANDROID_PGANDROID__)
     if (code == 66)
     {
         /* Run shutdown callbacks */
@@ -73,7 +77,7 @@ pg_proc_exit(int code)
         return;
     }
     /* For any other exit code, fall through to exit() below */
-#endif /* __EMSCRIPTEN__ || __wasi__ */
+#endif /* __EMSCRIPTEN__ || __wasi__ || __ANDROID_PGANDROID__ */

     exit(code);
 }

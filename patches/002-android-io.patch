  * The input buffer already contains the full query message.
  */
+#if defined(__ANDROID_PGANDROID__)
+    /* No-op: pgandroid_io_put_input() already loaded the full message */
+#endif

+/*
+ * pgl_pclose stub — referenced by wasm_common.h extern declaration.
+ * Not used in Android mode but must link.
+ */
+#if defined(__ANDROID_PGANDROID__)
+int pgl_pclose(FILE *stream) { (void)stream; return 0; }
+#endif


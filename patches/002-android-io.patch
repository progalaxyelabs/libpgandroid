+    pgandroid_io_write(PqSendBuffer, PqSendPointer);
+    PqSendStart  = 0;
+    PqSendPointer = 0;
+    return 0;
+#else
     /* Original: write to socket fd */
+#endif /* __ANDROID_PGANDROID__ */

 /*

# Build artifacts
build/
out/
*.o
*.so
*.a
*.out

# Track pre-built .so symlinks in jniLibs/ (they point to out/ but must be
# committed so the Android build can find them without a prior native build).
!**/jniLibs/**/*.so

# NDK / SDK (installed on host, not in repo)
ndk/
sdk/

# Android build outputs
*.apk
*.aab
*.dex

# Gradle caches
.gradle/
**/build/
local.properties

# Local env overrides
.env

# Upstream PostgreSQL source (cloned for analysis, not committed)
upstream/

# Cross-compiled third-party dependencies (built locally, not committed)
deps/

# Test binaries
test_pgandroid

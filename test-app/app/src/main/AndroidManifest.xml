<?xml version="1.0" encoding="utf-8"?>
<!--
    Minimal manifest for the pgandroid smoke-test APK.

    minSdk=29 (Android 10) is required by libpgandroid.so because it relies
    on shm_open() which is present in Android 10+ bionic libc.

    No permissions are needed — embedded PostgreSQL runs entirely in-process
    within the app's private data directory (no network, no storage access).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="pgAndroid Tests"
        android:debuggable="true"
        android:extractNativeLibs="true">
        <!-- No activities needed — this APK is a pure instrumented-test host -->
    </application>
</manifest>
